{
  "$schema": "./stack.schema.json",
  "$doc": "The stack profile. Adapted for vanilla single-file HTML/CSS/JS portfolio.",

  "adapted": true,
  "adaptedAt": "2026-11-14",

  "project": {
    "name": "marcus-vane-portfolio",
    "kind": "portfolio"
  },

  "framework": {
    "id": "html",
    "name": "Vanilla HTML/CSS/JS",
    "version": "HTML5",
    "renderModel": "static"
  },

  "language": "js",
  "packageManager": null,

  "paths": {
    "source": "index.html",
    "routes": null,
    "views": null,
    "components": null,
    "styles": null,
    "assets": null,
    "staticRoot": ".",
    "server": null,
    "env": null,
    "protected": [".claude/imported-skills/**"],
    "routeEntryGlob": []
  },

  "extensions": {
    "component": [".html"],
    "style": [".css"]
  },

  "bindings": {
    "styling": "css-tokens",
    "motion": "css-springs-js",
    "textMotion": "custom-split-text",
    "smoothScroll": "lenis",
    "state": "vanilla",
    "validation": null,
    "image": "native",
    "link": "native",
    "router": null,
    "envPublicPrefix": null
  },

  "capabilities": {
    "serverComponents": false,
    "apiRoutes": false,
    "imageOptimization": false,
    "edgeRuntime": false,
    "fontOptimization": false
  },

  "commands": {
    "dev": null,
    "build": null,
    "lint": null,
    "test": null,
    "typecheck": null
  },

  "conventions": {
    "springsNotKeyframes": true,
    "threeTierTokens": true,
    "routesDelegateToViews": false,
    "serverFirst": false,
    "namedLandmarks": true,
    "strictTypeScript": false,
    "singleEnvModule": false
  },

  "notes": [
    "Single-file static HTML/CSS/JS architecture for Marcus Vane dark-mode portfolio.",
    "Lenis smooth scroll loaded via CDN importmap.",
    "Spring-based motion with exact baked easing curves and vanilla JS/CSS transitions.",
    "Adaptive viewport rem grid scaling with root font-size."
  ]
}
